# Documentation only. Local start and explicit live-verification commands load ignored .env/.env.local.
# Keep live flags false until the specific credential use is approved; never commit real keys.
# Verify an exact NVIDIA model ID with GET https://api.tokenfactory.nebius.com/v1/models.
NEBIUS_ENABLE_LIVE=false
NEBIUS_API_KEY=
# Fast model: explain and remediation drafts.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Reasoning model: Promo Preflight free-form campaign -> rule interpretation.
# Also available: nvidia/Nemotron-3-Ultra-550b-a55b. Both IDs are checked against GET /v1/models before use.
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
TAVILY_ENABLE_LIVE=false
TAVILY_API_KEY=
PORT=3000
