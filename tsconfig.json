{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "server",
    "shared",
    "worker",
    "scripts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.csv-mapping.config.ts",
    "db",
    "drizzle.config.ts"
  ]
}
