{
  "name": "margin-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "build": "npm run build:frontend && npm run build:worker && node scripts/build-sites.mjs && node scripts/validate-artifact.mjs",
    "build:worker": "node --import tsx scripts/build-worker.ts",
    "start": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts --production",
    "start:qa": "node --import tsx server/index.ts --production --offline-qa",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:generate": "tsx scripts/generate-data.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "evaluate:policy": "node --import tsx scripts/evaluate-policy.ts",
    "evaluate:live": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/evaluate-live.ts",
    "benchmark:plan": "node scripts/benchmark/run.mjs plan",
    "benchmark:test": "node --test scripts/benchmark/*.test.mjs",
    "record:demo": "tsx scripts/record-demo.ts",
    "test:ui": "playwright test",
    "verify:live": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-live.ts",
    "verify:tavily": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-policy-live.ts --search-only",
    "verify:tavily-ui": "tsx scripts/verify-tavily-ui.ts",
    "verify:policy-live": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-policy-live.ts",
    "verify:integration": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-policy-integration.ts",
    "check": "npm run lint && npm run build && npm test && npm run benchmark:test && npm run evaluate && npm run evaluate:policy",
    "build:frontend": "tsc --noEmit && vite build",
    "db:generate": "drizzle-kit generate",
    "verify:policy-ui": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-policy-ui.ts",
    "build:offline-demo": "npm run build && node --import tsx scripts/build-worker.ts --offline-only && node scripts/verify-offline-artifact.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
